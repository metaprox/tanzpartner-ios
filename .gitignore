# gitignore contributors: remember to update .gitignore-contributor.xcodeproj

build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
#
Pods/

# Carthage
#
Carthage/Build

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
*.xcodeproj
*.xcworkspace

# fastlane
#
# Should not be added to Git since those files
# only change when you configure your lane.
Fastfile
Appfile
Pluginfile
OptionParser.db

# Playground
playground/

# Assets
Assets/
*.xctest

# Web-App (optional: node_modules nicht im Repo)
www/node_modules/
www/package-lock.json

# GitHub Desktop
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Test files
*.test.js
__tests__/

# Documentation
docs/*.md
README.md

